[Unit]
Description=Song proxy management (3x-ui)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=proxy-ui
Group=proxy-ui
WorkingDirectory=/var/lib/proxy-stack
Environment=XUI_DB_FOLDER=/var/lib/proxy-stack
Environment=XUI_BIN_FOLDER=/var/lib/proxy-stack/bin
Environment=XUI_LOG_FOLDER=/var/lib/proxy-stack/log
ExecStart=/opt/proxy-stack/x-ui
Restart=on-failure
RestartSec=5
LimitNOFILE=262144
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/proxy-stack
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
