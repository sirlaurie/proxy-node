[Unit]
Description=Publish Song client profiles from current panel subscriptions
After=proxy-ui.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/proxy-stack/node/export-profiles.py
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/proxy-publish /root/proxy-stack/clients
